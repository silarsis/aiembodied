{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["electron", "@earendil-works/pi-coding-agent", "typebox"],
      "entry": ["scripts/**/*.{mjs,js}!", "services/coder/src/coder/assets/*.ts!"],
      "project": ["scripts/**/*.{mjs,js}!", "services/coder/src/coder/assets/*.ts!"]
    },
    "app/main": {
      "ignoreBinaries": ["reg.exe"],
      "entry": [
        "src/preload.ts!",
        "src/wake-word/wake-word-worker.ts!",
        "src/avatar/generation/retexture-worker.ts!",
        "scripts/*.mjs!",
        "debug-avatar*.mjs!",
        "tests/**/*.ts"
      ],
      "project": ["src/**/*.ts!", "tests/**/*.ts", "scripts/*.mjs", "*.mjs"]
    },
    "app/renderer": {
      "entry": ["src/sit-lab/main.ts!", "tests/**/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}!", "tests/**/*.{ts,tsx}"]
    }
  }
}
